# --- LLM provider selection ---
LLM_PROVIDER=ollama

# --- Ollama (local, primary) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Ollama server resource limits (set in your shell BEFORE starting Ollama)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Cloud fallbacks (stubbed; add keys later if ever needed) ---
GEMINI_API_KEY=
GLM_API_KEY=

# --- Supabase (used from later cycles) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=